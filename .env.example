# cp .env.example .env して使う。開発用の値のみ。本番の値は絶対に書かない。

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# db/init/00-databases.sql で作成するサービスロールのパスワード（開発用）
AUTH_DB_PASSWORD=auth_pass
USER_DB_PASSWORD=user_pass
TODO_DB_PASSWORD=todo_pass

# ---- JWT / JWKS（design.md §6.1, §6.2）----
JWT_ISSUER=http://auth:8083
JWT_AUDIENCE=graphql-todo-api
# アクセストークンの有効期間。design.md §6.1 で 15 分に決定。
ACCESS_TOKEN_TTL=15m
# exp / nbf 判定のリーウェイ
JWT_LEEWAY=30s
# 秘密鍵の置き場所（make gen-keys で生成、gitignore 済み）
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem

# 検証側が参照する JWKS（auth サービス自身は使わない）
JWKS_URL=http://auth:8083/.well-known/jwks.json

# ---- クライアントから見た入口（design.md §8.4）----
# Envoy 無し: AUTH_BASE_URL=http://localhost:8083 / GRAPHQL_URL=http://localhost:3002/graphql
# Envoy あり: AUTH_BASE_URL=http://localhost:8080 / GRAPHQL_URL=http://localhost:8080/graphql
AUTH_BASE_URL=http://localhost:8083
GRAPHQL_URL=http://localhost:3002/graphql
